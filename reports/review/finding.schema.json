{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite1-ultra.local/review-finding.schema.json",
  "title": "Satellite1 Ultra review finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "severity",
    "status",
    "evidence_label",
    "evidence",
    "affected_files",
    "engineering_consequence",
    "verification_method"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 5},
    "severity": {
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "status": {
      "enum": ["OPEN", "ACCEPTED_RISK", "FIXED", "NOT_A_DEFECT"]
    },
    "evidence_label": {
      "enum": [
        "VERIFIED_DIGITALLY",
        "DERIVED_FROM_OFFICIAL_CAD",
        "DERIVED_FROM_MANUFACTURER_DRAWING",
        "ENGINEERING_ESTIMATE",
        "REQUIRES_PHYSICAL_VALIDATION"
      ]
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "affected_files": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "engineering_consequence": {"type": "string", "minLength": 5},
    "verification_method": {"type": "string", "minLength": 5},
    "owner": {"type": "string"},
    "resolution": {"type": "string"}
  }
}

